{
  "name": "@deadline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs && node e2e/case.mjs && node e2e/stage4.mjs && node e2e/coop.mjs && node e2e/server.mjs",
    "predev": "node --experimental-strip-types ../../scripts/build-content.ts",
    "pretest:e2e": "node --experimental-strip-types ../../scripts/build-content.ts"
  },
  "dependencies": {
    "@deadline/core": "*",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
